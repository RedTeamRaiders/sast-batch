{
  "jobDefinitionName": "sast-semgrep-only",
  "type": "container",
  "platformCapabilities": ["FARGATE"],
  "propagateTags": true,

  "containerProperties": {
    "image": "REPLACE_ACCOUNT.dkr.ecr.REPLACE_REGION.amazonaws.com/sast-batch-runner:REPLACE_TAG",

    "executionRoleArn": "arn:aws:iam::REPLACE_ACCOUNT:role/sastBatchExecutionRole",
    "jobRoleArn": "arn:aws:iam::REPLACE_ACCOUNT:role/sastBatchJobRole",

    "resourceRequirements": [
      { "type": "VCPU",   "value": "2" },
      { "type": "MEMORY", "value": "4096" }
    ],

    "fargatePlatformConfiguration": { "platformVersion": "LATEST" },
    "runtimePlatform": { "operatingSystemFamily": "LINUX", "cpuArchitecture": "X86_64" },

    "ephemeralStorage": { "sizeInGiB": 40 },

    "networkConfiguration": { "assignPublicIp": "ENABLED" },

    "environment": [
      { "name": "S3_BUCKET",       "value": "REPLACE_BUCKET" },
      { "name": "SEMGREP_CONFIGS", "value": "p/security-audit,p/owasp-top-ten,p/secrets" },
      { "name": "FAIL_ON_SEVERITY","value": "none" }
    ],

    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/aws/batch/sast",
        "awslogs-region": "REPLACE_REGION",
        "awslogs-stream-prefix": "semgrep"
      }
    }
  },

  "retryStrategy": {
    "attempts": 2,
    "evaluateOnExit": [
      { "onStatusReason": "Host EC2*",     "action": "RETRY"  },
      { "onReason": "CannotPullContainer*","action": "EXIT"   },
      { "onExitCode": "1",                 "action": "EXIT"   },
      { "onExitCode": "*",                 "action": "RETRY"  }
    ]
  },

  "timeout": { "attemptDurationSeconds": 2700 }
}
