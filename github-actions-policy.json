{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SubmitAndWatchJobs",
      "Effect": "Allow",
      "Action": ["batch:SubmitJob", "batch:DescribeJobs"],
      "Resource": "*"
    },
    {
      "Sid": "UploadSourceTarball",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::sast-reports-485237569462/scan-input/*"
    },
    {
      "Sid": "ReadReports",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::sast-reports-485237569462/sast-reports/*"
    },
    {
      "Sid": "ListReportsPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::sast-reports-485237569462",
      "Condition": { "StringLike": { "s3:prefix": "sast-reports/*" } }
    }
  ]
}
